{
  "framework": {
    "name": "gdpr",
    "version": "1.0.0"
  },
  "source": {
    "authority": "European Parliament and Council of the European Union",
    "regulation": "Regulation (EU) 2016/679 (GDPR)",
    "article": "Article 32(1)(d)",
    "paragraphs": [
      "32(1)(d)"
    ],
    "text": "A process for regularly testing, assessing and evaluating the effectiveness of technical and organisational measures for ensuring the security of the processing."
  },
  "operationalizes": "gsmarc://gsm-frameworks/gdpr/controller-processor/SecurityOfProcessing/v1",
  "qualifier": "gsmarc://gsm-frameworks/gdpr/controller-processor/GdprSecurityMeasure/v1",
  "applicability": "GdprControllerProcessorRole.role in ['CONTROLLER', 'JOINT_CONTROLLER', 'PROCESSOR'] && GdprSecurityMeasure.securityMeasuresImplemented == true",
  "assertion": "regularTestingPerformed == true",
  "toleranceMode": "INSTANTANEOUS"
}