  "applicability": "GdprControllerProcessorRole.role in ['CONTROLLER', 'JOINT_CONTROLLER'] && GdprProcessingPrinciple.principle == 'ACCOUNTABILITY'",
  "assertion": "principleCompliant == true",
  "toleranceMode": "INSTANTANEOUS"
}