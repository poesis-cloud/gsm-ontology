{
  "framework": {
    "name": "gdpr",
    "version": "1.0.0"
  },
  "source": {
    "authority": "European Parliament and Council of the European Union",
    "regulation": "Regulation (EU) 2016/679 (GDPR)",
    "article": "Article 5(1)(a)",
    "paragraphs": [
      "5(1)(a)"
    ],
    "text": "Personal data shall be processed lawfully, fairly and in a transparent manner in relation to the data subject ('lawfulness, fairness and transparency')."
  },
  "operationalizes": "gsmarc://gsm-frameworks/gdpr/principles/ProcessingPrinciples/v1",
  "qualifier": "gsmarc://gsm-frameworks/gdpr/principles/GdprProcessingPrinciple/v1",
  "applicability": "GdprControllerProcessorRole.role in ['CONTROLLER', 'JOINT_CONTROLLER'] && GdprProcessingPrinciple.principle == 'LAWFULNESS_FAIRNESS_TRANSPARENCY'",
  "assertion": "principleCompliant == true",
  "toleranceMode": "INSTANTANEOUS"
}