{
  "framework": {
    "name": "nis2",
    "version": "1.0.0"
  },
  "source": {
    "authority": "European Parliament and Council of the European Union",
    "regulation": "Directive (EU) 2022/2555 (NIS2)",
    "article": "Article 21(2)(e)",
    "text": "[Measures shall include at least:] (e) security in network and information systems acquisition, development and maintenance, including vulnerability handling and disclosure."
  },
  "operationalizes": "gsmarc://gsm-frameworks/nis2/risk-management/RiskManagement/v1",
  "qualifier": "gsmarc://gsm-frameworks/nis2/risk-management/Nis2RiskManagementMeasure/v1",
  "applicability": "Nis2EntityClassification.entityTier in ['ESSENTIAL', 'IMPORTANT'] && Nis2RiskManagementMeasure.measureCategory == 'NETWORK_AND_IS_ACQUISITION_SECURITY'",
  "assertion": "implementationLevel != 'NOT_IMPLEMENTED'",
  "toleranceMode": "INSTANTANEOUS"
}