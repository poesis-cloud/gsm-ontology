{
  "framework": {
    "name": "nis2",
    "version": "1.0.0"
  },
  "source": {
    "authority": "European Parliament and Council of the European Union",
    "regulation": "Directive (EU) 2022/2555 (NIS2)",
    "article": "Article 23(4)(c)",
    "paragraphs": [
      "23(4)(c)"
    ],
    "text": "Upon the request of the CSIRT or, where applicable, the competent authority, an intermediate report on relevant status updates."
  },
  "operationalizes": "gsmarc://gsm-frameworks/nis2/incident-reporting/IncidentReporting/v1",
  "qualifier": "gsmarc://gsm-frameworks/nis2/incident-reporting/Nis2IncidentReporting/v1",
  "applicability": "Nis2EntityClassification.entityTier in ['ESSENTIAL', 'IMPORTANT'] && Nis2IncidentReporting.significantIncident == true && Nis2IncidentReporting.reportingStage == 'INTERMEDIATE_REPORT'",
  "assertion": "deadlineHours <= 720",
  "toleranceMode": "INSTANTANEOUS"
}